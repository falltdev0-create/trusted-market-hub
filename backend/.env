# === Maskan Local Development Configuration ===

# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=maskan
APP_VERSION=2.0.0
DEBUG=true

# ── MySQL Database ────────────────────────────────────────────────────────
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maskandaba
DB_ECHO=false

DATABASE_URL=mysql+aiomysql://root@localhost:3306/maskandaba
# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=super-secret-key-change-this-in-production-at-least-32-chars!
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=30

# ── Storage (MinIO) ───────────────────────────────────────────────────────
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_IMAGES=maskan-images
STORAGE_BUCKET_DOCS=maskan-docs
STORAGE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS_STR=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000,http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80

# ── Hugging Face Models ───────────────────────────────────────────────────
HF_CONDITION_MODEL=microsoft/resnet-50
HF_DOCUMENT_MODEL=microsoft/trocr-large-handwritten
HF_PRICING_MODEL=google/flan-t5-base

# ── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE=http://localhost:8000
VITE_APP_NAME=معاملاتي
VITE_APP_VERSION=2.0.0

# ── Server Port ───────────────────────────────────────────────────────────
PORT=8000
